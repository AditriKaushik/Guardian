<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used only for the optional subscription: the web app talks to the payment server over
         HTTPS. The app itself is bundled in the APK and works fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Speech input ("बोलो"). Asked for only the first time the app listens, which the web app
         allows only after a grown-up turns the microphone on. Nothing heard is stored. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility: the phone's speech-recognition and text-to-speech
         services, and a browser for the payment page. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Privacy and security:
         - allowBackup="false" and data_extraction_rules keep the app's data — including the
           WebView storage that holds the child profiles and progress — out of cloud backups and
           phone-to-phone transfers: it never leaves this phone;
         - network_security_config allows HTTPS only, trusting only the phone's built-in
           certificate authorities (not user-installed ones). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/BuddyTheme">

        <!-- No WebView usage statistics are sent to Google from this app. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />

        <!-- The only activity. exported="true" for the launcher and for nanhaschool://open, the
             link the payment page uses to bring the app back; nothing is read from that link.
             Rotation, resizing, keyboard and dark-mode changes don't restart (reload) the page. -->
        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nanhaschool"
                    android:host="open" />
            </intent-filter>
        </activity>
    </application>
</manifest>
